{
  "uid": "ecilost-k6",
  "title": "ECILOST · k6",
  "description": "Comportamiento de la carga y de las peticiones vistas por el cliente.",
  "tags": [
    "ecilost",
    "rendimiento"
  ],
  "editable": true,
  "graphTooltip": 1,

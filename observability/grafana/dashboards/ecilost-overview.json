    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Corrida (testid)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "testid"
        },
        "definition": "label_values(k6_vus, testid)",
        "refresh": 2,
        "sort": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "Tableros ECILOST",
      "type": "dashboards",
      "tags": [
        "ecilost"

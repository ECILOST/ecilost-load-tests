{
  "name": "ecilost-load-tests",
  "version": "0.1.0",
  "description": "Pruebas de rendimiento de ECILOST (k6, Prometheus, Grafana) contra un entorno local aislado en Docker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "up": "docker compose up -d --build --wait",
    "down": "docker compose down",
    "scenario": "docker compose run --rm runner",
    "migrate": "node scripts/migrate-load.mjs",
    "service": "node scripts/start-service.mjs",
    "keys": "node scripts/keys.mjs",
    "tokens": "node scripts/tokens.mjs",
    "setup": "node scripts/setup.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "report": "node scripts/report.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "socket.io-client": "^4.8.4"
  }
}
